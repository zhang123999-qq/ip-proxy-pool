# ============================================================
# Docker 构建排除文件
# ============================================================
# 作用：让 docker build / docker compose build 跳过这些文件
#       → 镜像更小、构建更快、构建缓存更精准
# ------------------------------------------------------------

# Python 缓存（重新 build 总是会装新的）
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
.eggs
.pytest_cache
.mypy_cache
.ruff_cache

# 虚拟环境（容器自己装）
.venv
venv
env
.env

# IDE / 编辑器
.idea
.vscode
*.swp
*.swo

# 运行时数据（用卷挂载，不要打进镜像）
data/*
logs/*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.log
*.json.bak

# 测试（生产镜像不需要）
tests
data/verified_sources.txt
.coverage
htmlcov
.tox

# 文档（可选，文档不进镜像）
docs/*.md
README.md
开发方案.md

# Git
.git
.gitignore
.gitattributes

# Docker 自己（避免递归）
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# OS 临时文件
.DS_Store
Thumbs.db
*.tmp
*.bak
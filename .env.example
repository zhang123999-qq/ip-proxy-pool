# IP 代理池环境变量示例
# 复制为 .env 后按需修改

# 监听
API_HOST=0.0.0.0
API_PORT=8000
# 管理接口（/admin/*）的 Bearer Token，留空=关闭鉴权
ADMIN_TOKEN=

# 打分
INITIAL_SCORE=10
SCORE_UP=1
SCORE_DOWN=3
MAX_SCORE=20

# ===== 验证（v3 加速版）=====
# 单请求 HTTP 超时（秒）
VALIDATE_TIMEOUT=2
# HTTP 验证并发数
VALIDATE_CONCURRENCY=500
# 兼容老配置：单验证 URL（保留，会自动加到 VALIDATE_URLS）
VALIDATE_URL=
# 多 URL 投票（逗号分隔）：3 URL 过 2/3 算活
VALIDATE_URLS=https://1.1.1.1/cdn-cgi/trace,https://httpbin.org/ip,https://ifconfig.me
# 投票通过门槛（默认 2 = 3 票过 2 算活）
VALIDATE_PASS_THRESHOLD=2
# TCP 预筛并发数（Linux/Windows ephemeral port 28K+，撑得住 1000）
VALIDATE_TCP_CONCURRENCY=1000
# TCP 预筛超时（秒）
VALIDATE_TCP_TIMEOUT=1.0
# 验证失败是否重试 1 次（防瞬时抖动误杀免费代理）
VALIDATE_RETRY_ONCE=1
# 目标 URL 全局速率限制（req/s，防 CDN 报复）
VALIDATE_MAX_OK_RATE=300.0

# ===== 调度（v3 调整）=====
# 采集间隔（分钟）— 免费代理源更新频率不高，100 分钟已足够
JOB_CRAWL_INTERVAL_MIN=100
# 验证间隔（分钟）— 验证现在 ~75s/轮，8 分钟间隔避免排队
JOB_VALIDATE_INTERVAL_MIN=8
# 兜底持久化（小时）
JOB_PERSIST_INTERVAL_HOUR=1

# 日志
LOG_LEVEL=INFO
# 单文件最多保留多少行（达到即切新文件）
LOG_MAX_LINES=1000000
# 兜底保留天数（超过这个时间的老日志一定删）
LOG_RETENTION_DAYS=10
# IP 代理池环境变量示例
# 复制为 .env 后按需修改

# 监听
API_HOST=0.0.0.0
API_PORT=8000
# 管理接口（/admin/*）的 Bearer Token，留空=关闭鉴权
ADMIN_TOKEN=

# 打分
INITIAL_SCORE=10
SCORE_UP=1
SCORE_DOWN=3
MAX_SCORE=20

# 验证
VALIDATE_TIMEOUT=10
VALIDATE_CONCURRENCY=50
VALIDATE_URL=https://httpbin.org/ip

# 调度（分钟）
JOB_CRAWL_INTERVAL_MIN=10
JOB_VALIDATE_INTERVAL_MIN=5
JOB_PERSIST_INTERVAL_HOUR=1

# 日志
LOG_LEVEL=INFO
# 单文件最多保留多少行（达到即切新文件）
LOG_MAX_LINES=100000
# 兜底保留天数（超过这个时间的老日志一定删）
LOG_RETENTION_DAYS=10
